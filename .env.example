# API Configuration
NEXT_PUBLIC_API_URL=https://eliberia-backend.onrender.com

# Application
NEXT_PUBLIC_APP_NAME=PortaGov
NEXT_PUBLIC_APP_DESCRIPTION=Digital Library Platform

# GiinAI chat assistant (server only, never NEXT_PUBLIC_, never in the browser)
# GIINAI_URL is the base URL of the GiinAI service.
# GIINAI_APP_KEY is the PortaGov app key, sent as the X-GiinAI-Key header.
# Set both in Vercel (Production, Preview, Development) before go live.
# GIINAI_URL=
# GIINAI_APP_KEY=

# Optional: Analytics, Third-party services
# NEXT_PUBLIC_GA_ID=your-google-analytics-id
